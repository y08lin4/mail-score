{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mail-score",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_NAME": "邮件投递质量实验室"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
